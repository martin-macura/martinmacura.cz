---
import "@fontsource-variable/archivo/wdth.css";

const links = [
	{
		name: "GitHub",
		href: "https://github.com/2bad2furious",
	},
	{
		name: "X",
		href: "https://twitter.com/2bad2furious",
	},
	{
		name: "LinkedIn",
		href: "https://www.linkedin.com/in/martin-macura-41442013b/",
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#0c0c0c" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Martin Macura</title>
		<meta name="description" content="Martin Macura, a guy from Prague" />
	</head>
	<body>
		<main>
			<h1 aria-label="Martin Macura">
				<span aria-hidden="true">Martin</span>
				<span aria-hidden="true">Macura</span>
			</h1>
			<div class="meta">
				<p>a guy from Prague</p>
				<nav aria-label="Links">
					<ul>
						{
							links.map((link) => (
								<li>
									<a href={link.href} target="_blank" rel="noopener noreferrer">
										{link.name}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</main>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		--paper: #0c0c0c;
		--ink: #f2f2f2;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		background: var(--paper);
		color: var(--ink);
		font-family: "Archivo Variable", ui-sans-serif, system-ui, sans-serif;
		font-size: 1.125rem;
		line-height: 1.3;
		-webkit-font-smoothing: antialiased;
	}

	main {
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 2.5rem;
		min-height: 100vh;
		min-height: 100svh;
		padding: 2rem 1rem;
		overflow: hidden;
		container-type: inline-size;
		text-align: center;
	}

	/* Name: width and weight axes are driven by the pointer (see script below). */
	h1 {
		font-size: min(19.5cqw, 34svh);
		line-height: 0.86;
		letter-spacing: -0.02em;
	}

	h1 span {
		display: block;
		font-variation-settings:
			"wdth" 100,
			"wght" 800;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: baseline;
		gap: 0.5rem 2rem;
	}

	ul {
		list-style: none;
		display: flex;
		gap: 1.5rem;
	}

	a {
		color: inherit;
		font-weight: 500;
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.25em;
	}

	a:hover,
	a:focus-visible {
		background: var(--ink);
		color: var(--paper);
		outline: 0;
		text-decoration-color: transparent;
		box-shadow: 0 0 0 0.2em var(--ink);
	}
</style>

<script>
	// Line one widens while line two narrows as the pointer moves left-to-right;
	// vertical position sets the weight. Idle for 2.5s and it drifts on its own.
	if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const lines = [...document.querySelectorAll<HTMLElement>("h1 span")];
		let targetX = 0.5;
		let targetY = 0.5;
		let x = 0.5;
		let y = 0.5;
		let lastInput = -Infinity;
		let lastFrame = 0;

		const aim = (clientX: number, clientY: number) => {
			targetX = clientX / innerWidth;
			targetY = clientY / innerHeight;
			lastInput = performance.now();
		};
		addEventListener("pointermove", (e) => aim(e.clientX, e.clientY));
		addEventListener("touchmove", (e) => aim(e.touches[0].clientX, e.touches[0].clientY), { passive: true });

		const frame = (t: number) => {
			if (t - lastInput > 2500) {
				targetX = 0.5 + 0.5 * Math.sin(t / 2600);
				targetY = 0.5 + 0.5 * Math.sin(t / 3700 + 1);
			}
			const ease = 1 - Math.exp(-(t - lastFrame) / 140);
			x += (targetX - x) * ease;
			y += (targetY - y) * ease;
			const weight = Math.round(200 + 700 * y);
			lines.forEach((line, i) => {
				const width = 62 + 63 * (i === 0 ? x : 1 - x);
				line.style.fontVariationSettings = `"wdth" ${width.toFixed(1)}, "wght" ${weight}`;
			});
			lastFrame = t;
			requestAnimationFrame(frame);
		};
		requestAnimationFrame(frame);
	}
</script>

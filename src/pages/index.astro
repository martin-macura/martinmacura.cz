---
const links = [
	{
		name: "GitHub",
		href: "https://github.com/2bad2furious",
		icon: "github",
	},
	{
		name: "X",
		href: "https://twitter.com/2bad2furious",
		icon: "x",
	},
	{
		name: "LinkedIn",
		href: "https://www.linkedin.com/in/martin-macura-41442013b/",
		icon: "linkedin",
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Martin Macura</title>
		<meta name="description" content="Martin Macura" />
	</head>
	<body>
		<main>
			<p class="eyebrow">Ahoj, jsem</p>
			<h1>
				Martin<br />
				Macura<span class="dot">.</span>
			</h1>
			<p class="motto">a guy from Prague</p>
			<ul class="links">
				{
					links.map((link) => (
						<li>
							<a href={link.href} target="_blank" rel="noopener noreferrer">
								{link.icon === "github" ? (
									<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
									</svg>
								) : link.icon === "x" ? (
									<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
									</svg>
								) : (
									<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.114 20.452H3.558V9h3.556v11.452z" />
									</svg>
								)}
								<span>{link.name}</span>
								<span class="arrow">&rarr;</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: "Space Grotesk";
		src: local("Space Grotesk");
	}

	:root {
		color-scheme: light;
		--paper: #f2ede3;
		--ink: #1c1a17;
		--accent: #c65d3b;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html,
	body {
		height: 100%;
	}

	body {
		background: var(--paper);
		background-image:
			radial-gradient(circle at 1px 1px, rgba(28, 26, 23, 0.08) 1px, transparent 0);
		background-size: 22px 22px;
		color: var(--ink);
		font-family:
			ui-sans-serif,
			"Space Grotesk",
			"Helvetica Neue",
			Arial,
			sans-serif;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	main {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 2.5rem;
		padding: 3rem;
		max-width: 34rem;
	}

	.eyebrow {
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--accent);
	}

	h1 {
		font-size: clamp(3.2rem, 12vw, 6rem);
		font-weight: 700;
		line-height: 0.92;
		letter-spacing: -0.02em;
	}

	.dot {
		color: var(--accent);
	}

	.motto {
		font-size: 1.05rem;
		color: rgba(28, 26, 23, 0.65);
		margin-top: -1.25rem;
	}

	.links {
		list-style: none;
		display: flex;
		flex-direction: column;
		width: 100%;
		border-top: 2px solid var(--ink);
	}

	.links a {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 1.05rem 0.15rem;
		border-bottom: 2px solid var(--ink);
		color: var(--ink);
		text-decoration: none;
		font-size: 1.15rem;
		font-weight: 600;
		transition: color 0.2s ease, padding-left 0.2s ease;
	}

	.links a:hover {
		color: var(--accent);
		padding-left: 0.6rem;
	}

	.links svg {
		width: 1.15rem;
		height: 1.15rem;
		flex-shrink: 0;
	}

	.links span {
		flex-shrink: 0;
	}

	.arrow {
		margin-left: auto;
		transition: transform 0.2s ease;
	}

	.links a:hover .arrow {
		transform: translateX(4px);
	}
</style>
